## Make AFL Clients
# These will fail if the servers are not started yet
def make_client(host,port,name,client_name):
    try:
        client = Client(ip=host,port=port)
        client.login('notebook')
    except:
        warnings.warn(f'Unable to connect to {name} at http://{host}:{port}. Is the {name} server up on the AFL-Andon screen? (two green lights)?',stacklevel=2)
        client = None
    else:
        print(f'Set up AFL client for {name} under variable {client_name}')
    return client

robot_client = make_client('usaxscontrol',5002,'Robot OT2','robot_client')
orch_client = make_client('usaxscontrol',5050,'Orchestrator','orch_client')
inst_client = make_client('usaxscontrol',5000,'APSUSAXS','inst_client')
agent_client = make_client('usaxscontrol',5051,'AFL Agent','agent_client')
load_client = make_client('afl-loader',5000,'Loader','load_client')

